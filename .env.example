# ---- App runtime configuration (read by the web app AND the worker) ----

# Postgres connection string. Postgres runs in a separate container/service.
DATABASE_URL=postgresql://dialert:dialert@localhost:5432/dialert

# Single-user login password for the web UI.
APP_PASSWORD=change-me-to-a-long-password

# Secret used to sign session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-session-secret

# 32-byte key (hex or base64) to encrypt secrets stored in Postgres.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-byte-base64-key

# ---- Shared FreePBX credentials (all systems currently use one FreePBX) ----
# Per-system overrides can be added later in the DB.
FREEPBX_API_URL=https://pbx.example.com/admin/api/api/
# Optional: defaults to "<FREEPBX_API_URL>/gql" if unset.
FREEPBX_GQL_URL=https://pbx.example.com/admin/api/api/gql
FREEPBX_CLIENT_ID=superlongclientidhere
FREEPBX_CLIENT_SECRET=superlongclientsecrethere
FREEPBX_SCOPE=gql:ringgroups gql:framework

# ---- Error-notification email (optional) ----
# If SMTP_SERVER or ERROR_EMAIL_ADDRESS is unset, errors are only logged/stored.
ERROR_EMAIL_ADDRESS=errors@example.com
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=superlongsmtppasswordhere
SMTP_FROM="DiALERT" <noreply@example.com>

# Default timezone for scheduling display.
TZ=America/New_York

# The container runs the polling scheduler in the background by default. Set to
# "false" only if you run a dedicated worker container (npm run worker).
# RUN_SCHEDULER=true

# Audit-log retention (days). Successful applies are pruned after
# EVENT_RETENTION_DAYS; errors are kept longer (ERROR_RETENTION_DAYS).
# "No schedule change" polls are never recorded.
# EVENT_RETENTION_DAYS=14
# ERROR_RETENTION_DAYS=90
