{
  "name": "dialert",
  "version": "2.0.0",
  "description": "DiALERT — web UI to manage FreePBX ring-group chains for multiple phone systems from a schedule.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "deploy": "./scripts/deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkbluellc/dialert.git"
  },
  "author": "Dark Blue LLC",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "jose": "^5.9.6",
    "next": "^15.5.20",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "prisma": "^6.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-oauth2": "^5.1.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@types/simple-oauth2": "^5.0.7",
    "autoprefixer": "^10.4.20",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
