# Secrets used ONLY by scripts/deploy.sh. Copy to scripts/deploy.env
# (gitignored) and fill in. These are NOT read by the running app.

# GitHub Container Registry credentials.
# GHCR_PAT needs write:packages scope.
GHCR_USER=your-github-username
GHCR_PAT=ghp_xxxxxxxxxxxxxxxxxxxx

# Coolify deploy trigger.
# COOLIFY_URL: base URL of your Coolify instance (no trailing /api).
# COOLIFY_TOKEN: an API token from Coolify (Keys & Tokens > API).
# COOLIFY_UUID: the resource UUID of the DiALERT application in Coolify.
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=coolify-api-token-here
COOLIFY_UUID=resource-uuid-here
